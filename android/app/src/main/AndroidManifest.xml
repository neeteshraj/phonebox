<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Dictation widget only: asked for the first time its microphone button is tapped -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Notifications while the panel is not on screen: what Claude Code is doing, permission prompts with Allow / Deny -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 11+: the speech recognizer has to be visible to the app (Dictation widget) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="PhoneBox"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeskPanel">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pairing without USB: the QR code on the computer's settings page. Android 12+ opens unverified https
                 links in the browser; that page then offers phonebox://pair (the second filter). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="ersinkoc.github.io" android:pathPrefix="/phonebox/pair" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="phonebox" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- Settings › Display › "Use as the phone's home screen": enabled by the app itself (off by default). As the home
             app the panel starts after a reboot and the Home button returns to it; no root needed. -->
        <activity-alias
            android:name=".HomeAlias"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Watches the computer while the panel is in the background and posts Claude Code notifications -->
        <service
            android:name=".AlertService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:targetApi="34">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a link to the user's own computer to show its AI coding sessions' permission prompts and activity as notifications" />
        </service>
        <receiver android:name=".AlertActionReceiver" android:exported="false" />

        <!-- Home-screen widgets, fed by AlertService (Widgets.kt) -->
        <receiver
            android:name=".ClaudeWidget"
            android:exported="false"
            android:label="@string/widget_claude_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_claude_info" />
        </receiver>
        <receiver
            android:name=".MediaWidget"
            android:exported="false"
            android:label="@string/widget_media_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_media_info" />
        </receiver>

        <!-- Quick Settings tile (Edit tiles › PhoneBox): opens the panel. Tiles exist from Android 7.0; below that the
             service is disabled (values/bools.xml vs values-v24). -->
        <service
            android:name=".PanelTile"
            android:enabled="@bool/quick_settings_tile"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="PhoneBox"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            tools:targetApi="n">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="false" />
        </service>
    </application>
</manifest>
