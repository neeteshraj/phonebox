<?xml version="1.0" encoding="utf-8"?>
<!-- Claude widget: 4×1, resizable up to 4×2 (the extra row shows more of the command). Updates are pushed by
     AlertService, so no periodic update. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_claude_desc"
    android:initialLayout="@layout/widget_claude"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:maxResizeHeight="180dp"
    android:previewLayout="@layout/widget_claude"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
