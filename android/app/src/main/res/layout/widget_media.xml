<?xml version="1.0" encoding="utf-8"?>
<!-- Now playing widget (RemoteViews: only framework layouts and views). Also its picker preview on Android 12+. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/m_art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_art_bg"
        android:contentDescription="@null"
        android:padding="12dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_tile" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/m_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/widget_nothing_playing"
            android:textColor="#FFECE6F0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/m_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FFB8B0C0"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/m_prev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/widget_prev"
        android:padding="8dp"
        android:src="@drawable/ic_w_prev" />

    <ImageView
        android:id="@+id/m_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/widget_btn_round"
        android:contentDescription="@string/widget_playpause"
        android:padding="10dp"
        android:src="@drawable/ic_w_play" />

    <ImageView
        android:id="@+id/m_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/widget_next"
        android:padding="8dp"
        android:src="@drawable/ic_w_next" />
</LinearLayout>
